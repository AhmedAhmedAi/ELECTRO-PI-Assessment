# --- Keys (required) ---------------------------------------------------------
OPENAI_API_KEY=sk-...            # STT always; also the LLM when LLM_PROVIDER=openai
GOOGLE_API_KEY=...               # needed for the default LLM_PROVIDER=google
ELEVENLABS_API_KEY=...           # needed for the default TTS_PROVIDER=elevenlabs

# --- Vendor switches (Task 1.2: swap = config change, no code change) --------
LLM_PROVIDER=google              # openai | google
TTS_PROVIDER=elevenlabs          # openai | elevenlabs

# --- Language mode -----------------------------------------------------------
# Set both to "ar" for the Egyptian Arabic persona (also pick an Arabic
# ElevenLabs voice in tuning.py).
STT_LANGUAGE=en
PERSONA_LANG=en

# --- Demo dials --------------------------------------------------------------
# Fake backend latency (ms) inside the tools so the filler race is observable;
# 0 = off. CANCEL_LATENCY_MS falls back to TOOL_LATENCY_MS when unset.
TOOL_LATENCY_MS=0
CANCEL_LATENCY_MS=0

# All measured tuning decisions (timers, models, voices) live in tuning.py
# with their rationale -- edit that file to change them.
